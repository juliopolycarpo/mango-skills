{
  "lineWidth": 100,
  "indentWidth": 2,
  "newLineKind": "lf",
  "markdown": { "textWrap": "maintain" },
  "includes": ["**/*.md", "**/*.yaml", "**/*.yml", "**/*.mjs", "*.json"],
  "excludes": ["**/node_modules", "**/.git", "**/fixtures"],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.26.0.wasm",
    "https://plugins.dprint.dev/typescript-0.93.2.wasm",
    "https://plugins.dprint.dev/json-0.21.3.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm"
  ]
}
